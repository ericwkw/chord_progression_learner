# The "AI Analyst" panel needs an API key. Copy this file to `.env.local` and
# fill one in. The app runs fully without it — only that panel is disabled.

# Key for whichever OpenAI-compatible provider LLM_BASE_URL points at.
# Free key: https://openrouter.ai/keys
API_KEY=

# Defaults to OpenRouter + a free model. Override both to use a different
# provider, e.g. Gemini's OpenAI-compatible endpoint:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_MODEL=
